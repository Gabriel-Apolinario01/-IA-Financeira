# Azure App Service Authentication is configured in the Azure portal.
# Set these two settings in App Service, never in a browser-exposed variable.
AZURE_AUTH_MODE=app-service
AZURE_TENANT_ID=

# Azure Database for PostgreSQL Flexible Server.
# Production: use a system-assigned managed identity and these fields.
AZURE_POSTGRES_HOST=
AZURE_POSTGRES_DATABASE=iafinanceira
AZURE_POSTGRES_USER=
AZURE_POSTGRES_PORT=5432
AZURE_POSTGRES_POOL_SIZE=5

# Local development only: optionally use a password-based PostgreSQL URL in .env.local.
# Never commit a real connection string.
AZURE_POSTGRES_CONNECTION_STRING=
AZURE_POSTGRES_SSL=true

# Optional explanations provider. The app remains rule-based when not configured.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
