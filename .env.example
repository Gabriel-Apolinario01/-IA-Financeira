# Backend nativo Cloudflare/Sites. Nunca use prefixo NEXT_PUBLIC para segredos.
# Em desenvolvimento, variáveis do Worker usam .dev.vars (ignorado no Git).
# O aplicativo funciona sem provedor externo.
AI_ENABLED=false
OPENAI_API_KEY=
# Preencha um modelo compatível com Responses e Structured Outputs na sua conta.
OPENAI_MODEL=
