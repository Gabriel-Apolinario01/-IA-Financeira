# Email/password login. Copy to .env.local for a manually provisioned database.
# npm run dev:local sets local database/auth values automatically.
AZURE_AUTH_MODE=email
# Generate a random secret locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Origin only, no trailing slash. HTTPS is required outside localhost.
BETTER_AUTH_URL=http://localhost:5174

# PostgreSQL: choose ONE connection option, never commit credentials.
# Password URL: percent-encode special characters in credentials.
AZURE_POSTGRES_CONNECTION_STRING=
# Or Azure managed identity (no password in the application):
AZURE_POSTGRES_HOST=
AZURE_POSTGRES_DATABASE=iafinanceira
AZURE_POSTGRES_USER=
AZURE_POSTGRES_PORT=5432
AZURE_POSTGRES_POOL_SIZE=5
# false is accepted ONLY for localhost. Azure must use true.
AZURE_POSTGRES_SSL=true

# External text provider. Configure credentials, model and budget before enabling.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
AI_GLOBAL_DAILY_LIMIT=200
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional image transcription. Local Portuguese OCR works with this off.
DOCUMENT_VISION_ENABLED=false
GROQ_VISION_MODEL=

# Legacy optional Microsoft Entra mode: AZURE_AUTH_MODE=app-service
AZURE_TENANT_ID=
