{
  "name": "ia-financeira-azure",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 5174",
    "build": "next build --webpack",
    "start": "node --env-file-if-exists=.env.local scripts/start-azure.mjs",
    "prepare:azure-db": "node --env-file-if-exists=.env.local scripts/prepare-azure-db.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern .azure-data",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "db:prepare": "node --env-file-if-exists=.env.local scripts/prepare-azure-db.mjs",
    "dev:local": "node --env-file-if-exists=.env.local scripts/local-dev.mjs",
    "verify:ai": "node --env-file-if-exists=.env.local --import tsx scripts/verify-ai.ts"
  },
  "dependencies": {
    "@azure/identity": "4.14.1",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@tesseract.js-data/por": "1.0.0",
    "better-auth": "1.7.25",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "10.6.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "7.0.0",
    "vaul": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
